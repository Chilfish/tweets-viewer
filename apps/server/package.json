    "@tweets-viewer/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "hono-openapi": "^1.5.0",
    "nitro": "^3.0.261029-rc"
  },
  "devDependencies": {
    "miniflare": "4.20260730.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
