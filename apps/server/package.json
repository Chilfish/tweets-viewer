{
  "name": "@tweets-viewer/server",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite build; wrangler dev",
    "build": "cross-env NODE_ENV=production vite build",
