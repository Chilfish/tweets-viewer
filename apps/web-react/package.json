{
  "name": "@tweets-viewer/web-react",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "cross-env NODE_ENV=production react-router build",
    "dev": "cross-env NODE_ENV=development react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "cross-env NODE_ENV=test vitest run --project unit --project stories",
    "test:watch": "cross-env NODE_ENV=test vitest --project unit --project stories",
    "test:visual": "cross-env NODE_ENV=test vitest run --project vrt",
    "test:visual:watch": "cross-env NODE_ENV=test vitest --project vrt"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@tweets-viewer/rettiwt-api": "workspace:*",
    "@tweets-viewer/shared": "workspace:*",
    "axios": "^1.21.0",
    "axios-cache-interceptor": "^1.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "spin-delay": "^2.0.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.7",
    "@chromatic-com/storybook": "^5.6.0",
    "@react-router/dev": "^8.5.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/react-router": "^1.3.7",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-storybook": "^10.6.5",
    "jsdom": "^30.1.3",
    "playwright": "1.62.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5",
    "vite-plugin-babel": "^1.7.3",
    "vitest": "^5.0.5"
  }
}
