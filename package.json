{
  "name": "tweets-viewer",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --cwd apps/server dev",
    "dev:client": "bun --cwd apps/web-react dev",
    "build:client": "bun --cwd apps/web-react build",
    "deploy": "bun --cwd apps/server deploy",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "typecheck": "bun --cwd apps/web-react typecheck",
    "test": "bun --cwd packages/rettiwt-api test && bun --cwd packages/shared test && bun --cwd packages/database test && bun --cwd apps/server test && bun --cwd apps/web-react test",
    "test:visual": "bun --cwd apps/web-react test:visual"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "rolldown": "^1.2.15",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "typescript": "6.0.3"
  }
}
