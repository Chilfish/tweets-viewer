{
  "name": "tweets-viewer",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun run --cwd ./apps/server dev",
    "dev:client": "bun run --cwd ./apps/web-react dev",
    "build:client": "bun run --cwd ./apps/web-react build",
    "deploy": "bun run --cwd ./apps/server deploy",
    "lint": "eslint . --fix"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "rolldown": "^1.2.1",
    "vite": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-format": "^2.0.1",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "typescript": "~6.0.2"
  }
}
