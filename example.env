# Postgres 连接串；逗号分隔多地址 = 每日抓取对每个库并发更新（首个为主库），地址内逗号写 %2C
DATABASE_URL=postgresql://
# https://github.com/Rishikant181/Rettiwt-API
TWEET_KEYS=

# ── 本地开发（LOCAL=1 时生效，见 docs/engineering/local-database.md）──
# 1 = 数据库与媒体地址全部切到本机；不设或 0 = 线上
# LOCAL=1
# DATABASE_URL=postgres://postgres@localhost:5432/tweets_dev
# 本机 Neon /sql 代理；LOCAL=1 且缺省时回落到 http://127.0.0.1:4444/sql
# NEON_HTTP_ENDPOINT=http://127.0.0.1:4444/sql

# IG 媒体 CDN 前缀（下载后改写、API 输出共用）
# IG_CDN_BASE=https://s3.chilfish.top
# Instagram 登录 Cookie，IG 抓取用
# INSTAGRAM_COOKIES=
