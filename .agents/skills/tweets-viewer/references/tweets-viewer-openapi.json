              "default": 10
            }
          },
          {
            "in": "query",
            "name": "reverse",
            "required": false,
            "description": "排序方向：true = 旧→新，false = 新→旧",
            "schema": { "type": "boolean", "default": false }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
