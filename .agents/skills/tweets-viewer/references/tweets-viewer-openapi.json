          "400": {
            "description": "错误响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v3/users/all": {
      "get": {
        "operationId": "getV3UsersAll",
        "tags": ["Users"],
        "summary": "获取所有用户",
        "description": "数据库中记录的所有用户信息。",
        "responses": {
          "200": {
            "description": "用户列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EnrichedUserList" }
              }
            }
          }
        }
      }
    },
    "/v3/users/get/{name}": {
      "get": {
        "operationId": "getV3UsersGetByName",
        "tags": ["Users"],
        "summary": "获取指定用户信息",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "description": "用户 Screen Name（`\\w+`）",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "pattern": "^\\w+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "用户信息",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EnrichedUser" }
              }
            }
          },
          "404": {
            "description": "错误响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v3/image/get": {
      "get": {
        "operationId": "getV3ImageGet",
        "tags": ["Image"],
        "summary": "获取随机图片",
        "description": "从归档推文中随机选取一张媒体图片（排除转推），可选 `name` 限定用户；返回图片链接与来源推文。",
        "parameters": [
          {
            "in": "query",
            "name": "name",
            "required": false,
            "description": "限定用户 Screen Name；缺省为全库",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "pattern": "^\\w+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "随机图片条目（图片链接 + 来源推文）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ImageEntry" }
              }
            }
          },
          "400": {
            "description": "错误响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "错误响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v3/ins/{name}": {
      "get": {
        "operationId": "getV3InsByName",
        "tags": ["Instagram"],
        "summary": "获取 IG 用户信息与帖子",
        "description": "`:name` 为 twitter userName（非 IG 用户名），服务端经 `users.ins_json_data` 映射。",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "description": "用户 Screen Name（`\\w+`）",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "pattern": "^\\w+$"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "description": "页码（offset 定位）",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "IG 用户信息 + 分页帖子",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IGUserPageResponse" }
              }
            }
          },
          "404": {
            "description": "该用户无 IG 数据且无帖子",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IGUserPageResponse" }
              }
            }
          }
        }
      }
    }
  }
}
