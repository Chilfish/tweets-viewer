            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "description": "页码（offset 定位，分页器跳页用）",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "description": "每页数量（1-100）",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "reverse",
            "required": false,
            "description": "排序方向：true = 旧→新，false = 新→旧",
            "schema": { "type": "boolean", "default": false }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "description": "keyset 游标（滚动续载，优先于 page）",
            "schema": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        ],
        "responses": {
          "200": {
            "description": "分页「那年今日」推文",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedTweets" }
              }
            }
          },
          "400": {
            "description": "错误响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v3/tweets/last-years-today": {
      "get": {
        "operationId": "getV3TweetsLastYearsToday",
